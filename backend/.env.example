# =====================================================================
# AegisTrust Environment Configuration Template
# =====================================================================

# Optional: Google Gemini API Key for dynamic natural language explanations
# If left empty, AegisTrust automatically falls back to the deterministic
# offline explanation engine (zero latency, zero external network dependency).
GEMINI_API_KEY=

# Server Configuration
AEGIS_HOST=0.0.0.0
AEGIS_PORT=8000
AEGIS_DEBUG=false

# SSRF Protection Defaults
SSRF_CONNECT_TIMEOUT_SECONDS=3.5
SSRF_MAX_REDIRECT_HOPS=5

# Web3 Smart Contract & Blockchain Settings (Ethereum Sepolia Testnet)
WEB3_NETWORK=sepolia
WEB3_CHAIN_ID=11155111
WEB3_RPC_URL=https://rpc.sepolia.org
REPORT_REGISTRY_CONTRACT_ADDRESS=0x3A52c8087C174825965476a2638e469279A823B0
